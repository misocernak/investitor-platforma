APP_NAME=StructureOps
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://vas-domen.rs

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=structureops
DB_USERNAME=structureops
DB_PASSWORD=tajna_lozinka

SESSION_DRIVER=file
SESSION_LIFETIME=480
CACHE_DRIVER=file
QUEUE_CONNECTION=database
MAIL_MAILER=sendmail
MAIL_FROM_ADDRESS=noreply@temelj.info
MAIL_FROM_NAME="Temelj Investitor"

# Faza 2 (AWS S3) - ostaviti prazno na cPanelu
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=

# Veza sa Temelj.rs (oglasi stanova i upiti kupaca) — ključ mora biti isti kao 'investitor_api.kljuc' u app/config.php na Temelju
TEMELJ_URL=https://tmltest.temelj.info
TEMELJ_API_KLJUC=
# Samo ako je Temelj sajt zaključan lozinkom (cPanel Directory Privacy) — inače prazno
TEMELJ_HTTP_KORISNIK=
TEMELJ_HTTP_LOZINKA=
